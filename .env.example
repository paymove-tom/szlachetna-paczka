# Wklej w Vercel → Settings → Environment Variables (Production).
# Fine-grained PAT tylko do tego repozytorium, uprawnienie Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=paymove-tom/szlachetna-paczka
GITHUB_BRANCH=main

# Lokalnie npm start i tak wymusza pliki, dopóki nie ustawisz LOCAL_MODE=0.
LOCAL_MODE=1
